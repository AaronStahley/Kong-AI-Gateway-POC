# Copy to part-01/.env (gitignored) and load with: set -a; source part-01/.env; set +a
# docker compose reads it automatically.

# --- Step 1: gateway and data plane ---------------------------------------------------------
# Konnect personal access token, for the step 1 API calls (and kongctl, if you don't use login)
KONNECT_TOKEN=

# The gateway's ID, from the step 1 lookup or the Konnect AI Gateway page
AI_GATEWAY_ID=

# Cluster endpoint hostnames from the step 1 lookup, no https:// or port (e.g. 1a2b3c.us.cp.konghq.com)
KONG_CLUSTER_CONTROL_PLANE_HOST=
KONG_CLUSTER_TELEMETRY_HOST=

# Optional: your group ID (`id -g`), so the data plane can read part-01/certs/tls.key. Default 1000.
# HOST_GID=1000

# --- Step 2: gateway configuration (kongctl apply) ------------------------------------------
# The real Anthropic key, stored in Konnect on apply. Claude Code never reads this name.
ANTHROPIC_PROVIDER_API_KEY=

# One gateway key per developer (openssl rand -hex 32). A new value replaces that developer's key.
ENG_DEV_1_KEY=
ENG_DEV_2_KEY=
FIN_DEV_1_KEY=

# --- Steps 3-5: developer (Claude Code through the gateway) ---------------------------------
ANTHROPIC_BASE_URL=http://localhost:8000/
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-main
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-fast
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
# Separate Claude Code profile with no claude.ai login, so the gateway key is the only credential
CLAUDE_CONFIG_DIR=${HOME}/.claude-kong-dev

# Which developer you are (${FIN_DEV_1_KEY} for finance). Edit only KONG_GATEWAY_KEY: Claude Code
# won't expand ANTHROPIC_API_KEY in MCP headers, so mcp.json uses this name.
KONG_GATEWAY_KEY=${ENG_DEV_1_KEY}
ANTHROPIC_API_KEY=${KONG_GATEWAY_KEY}

# Your own fine-grained GitHub token, forwarded to GitHub by the MCP server (shared/claude/mcp.json)
GITHUB_PAT=

# Gateway address for shared/claude/mcp.json (optional; defaults to http://localhost:8000)
# KONG_PROXY_URL=http://localhost:8000
