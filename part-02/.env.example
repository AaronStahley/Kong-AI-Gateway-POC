# Copy to part-02/.env (gitignored). The Makefile and test_gateway.py load it themselves.

# --- Admin: Konnect and Terraform -------------------------------------------------------------
# Konnect token, for Terraform and (via `make konnect-secret`) Kong Operator
KONNECT_TOKEN=

# The real Anthropic key. Stored in Konnect by Terraform; developers never see it.
ANTHROPIC_PROVIDER_API_KEY=

# One gateway key per developer (openssl rand -hex 32). Reusing Part 1's values is fine.
ENG_DEV_1_KEY=
ENG_DEV_2_KEY=
FIN_DEV_1_KEY=

# Terraform reads its variables from TF_VAR_<name>. Derived from the values above: don't edit.
TF_VAR_konnect_personal_access_token=${KONNECT_TOKEN}
TF_VAR_anthropic_provider_api_key=${ANTHROPIC_PROVIDER_API_KEY}
TF_VAR_developer_keys="{\"eng-dev-1\":\"${ENG_DEV_1_KEY}\",\"eng-dev-2\":\"${ENG_DEV_2_KEY}\",\"fin-dev-1\":\"${FIN_DEV_1_KEY}\"}"

# --- Developer: Claude Code through the gateway (same as Part 1) ------------------------------
ANTHROPIC_BASE_URL=http://localhost:8000/
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-main
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-fast
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
# Separate Claude Code profile with no claude.ai login, so the gateway key is the only credential
CLAUDE_CONFIG_DIR=${HOME}/.claude-kong-dev

# Which developer you are (${FIN_DEV_1_KEY} for finance). Edit only KONG_GATEWAY_KEY: Claude Code
# won't expand ANTHROPIC_API_KEY in MCP headers, so mcp.json uses this name.
KONG_GATEWAY_KEY=${ENG_DEV_1_KEY}
ANTHROPIC_API_KEY=${KONG_GATEWAY_KEY}

# Your own fine-grained GitHub token, forwarded to GitHub by the MCP server (shared/claude/mcp.json)
GITHUB_PAT=

# Gateway address for shared/claude/mcp.json and the tests (optional; defaults to http://localhost:8000)
# KONG_PROXY_URL=http://localhost:8000
